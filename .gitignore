# Local runtime data (regenerated from seeds)
prototypes/*/data/db.json
prototypes/*/data/*.json

# Logs and temporary files
*.log
.DS_Store
Thumbs.db

# Lockfiles: npm only (ADR-0011). A pnpm lockfile generated by a stray `pnpm install` must never be committed.
pnpm-lock.yaml

# Dependencies and build output (.nx/.pnpm-store reserved for ADR-0001 tooling)
node_modules/
dist/
.nx/
.pnpm-store/

# Local backups
*.tar.gz
!docs/**/*.tar.gz
node_modules/
.local/
*.tsbuildinfo

# Local scratch, probes and credential-bearing files (never commit)
.env
.env.*
!.env.example
.scratch/
.scratch-*/
.probe/
.list.mts
*.bundle

# Vercel local link (never commit project linkage)
.vercel/
